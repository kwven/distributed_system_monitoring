* text=auto

# Enforce LF for source
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.go text eol=lf
*.sh text eol=lf
*.md text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
